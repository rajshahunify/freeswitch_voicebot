# =============================================================================
# GPU SERVER CONFIGURATION — 10.32.28.29 (6x NVIDIA H100)
# =============================================================================
# Copy this file to .env.gpu and fill in your API keys.
#
# Port remapping to avoid conflicts with existing services:
#   SIP:       5060 → 5062 (livekit-sip uses 5060)
#   WebSocket: 8000 → 8080 (text-analytics uses 8000)
#   Redis:     reuses existing host Redis on 6379
# =============================================================================

# --- STT Provider ---
# "remote" = external Faster-Whisper server (default, no GPU needed)
# "local"  = local Faster-Whisper model (use GPU for faster inference)
STT_PROVIDER=local
STT_REMOTE_URL=http://164.52.203.140:8890/transcribe
STT_LOCAL_MODEL=large-v3
STT_LOCAL_DEVICE=cuda

# --- LLM Provider ---
# "gemini" = Google Gemini API (needs GEMINI_API_KEY)
# "ollama" = Local Ollama on this server (needs ollama serve running)
# Set to "ollama" for local/offline GPU testing
LLM_PROVIDER=ollama
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama — runs natively on the host, container reaches it via host.docker.internal
# Start with: CUDA_VISIBLE_DEVICES=1 OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Groq Provider (cloud fallback) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM System Prompt ---
LLM_SYSTEM_PROMPT_FILE=ivr/system_prompt.txt

# --- TTS ---
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_CACHE_DIR=/app/tts_cache

# --- Barge-In ---
ALLOW_INTERRUPTIONS=true
